# Public Supabase project values (safe to embed in the native app).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Required for EAS production builds. The AdMob APP ID is written to AndroidManifest.xml.
# Ad unit IDs are fetched remotely from public.app_settings after launch; these are dev fallbacks.
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-0000000000000000~0000000000
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID=ca-app-pub-3940256099942544/6300978111
EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ID=ca-app-pub-3940256099942544/5224354917

# Android Google Maps SDK key, restricted to in.gallirent.app and Maps SDK for Android.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=REPLACE_WITH_RESTRICTED_ANDROID_MAPS_KEY

# Netlify/GitHub Pages URL for terms.html. Leave empty to use the bundled full-text terms.
EXPO_PUBLIC_TERMS_URL=https://YOUR_SITE.netlify.app/terms.html
