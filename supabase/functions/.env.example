# Supabase injects SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY.
# Set the remaining values with `supabase secrets set --env-file ./supabase/functions/.env`.

# Optional comma-separated AdMob rewarded ad unit IDs or numeric suffixes.
# Leave empty only while testing a dedicated SSV callback URL.
ADMOB_ALLOWED_AD_UNITS=

# Defaults to Google's production rewarded SSV key server.
ADMOB_VERIFIER_KEYS_URL=https://www.gstatic.com/admob/reward/verifier-keys.json

# Android package whose subscription purchases may be verified.
GOOGLE_PLAY_PACKAGE_NAME=in.gallirent.app

# Full Google Cloud service-account JSON as a one-line secret. The service
# account must have Google Play Console API access to this app.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"","private_key":"","client_email":""}
